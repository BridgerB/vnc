{
	"name": "vnc",
	"private": true,
	"version": "0.1.0",
	"description": "Self-hosted remote desktop in the browser: VNC (RFB) plus a low-latency H.264 (NVENC → WebCodecs) streaming path.",
	"license": "MIT",
	"keywords": [
		"vnc",
		"rfb",
		"remote-desktop",
		"webcodecs",
		"h264",
		"nvenc",
		"streaming",
		"sveltekit"
	],
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome check",
		"format": "biome check --write",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@bridgerb/port-from-name": "^1.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.4.0",
		"@types/ws": "^8.18.1",
		"@vitest/browser-playwright": "^4.1.8",
		"playwright": "^1.60.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"pako": "^3.0.1",
		"ws": "^8.21.3"
	}
}
